#!/bin/sh
# ccn の実行物。symlink（~/.local/bin/ccn）から呼ばれても、実体の隣の src/cli/ccn.ts を bun で動かす
self="$0"
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
exec bun run "$root/src/cli/ccn.ts" "$@"
